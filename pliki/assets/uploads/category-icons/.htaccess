Options -Indexes

<IfModule mod_mime.c>
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "sandbox"
</IfModule>

<FilesMatch "\.(php|phtml|phar|html?|js)$">
    Require all denied
</FilesMatch>
