APP_ENV=production
APP_PORT=8080
SITE_URL=https://example.com
CANONICAL_HOST=example.com
DB_HOST=private-db-host
DB_PORT=3306
DB_NAME=app_production
DB_USER=app_production
DB_PASSWORD=CHANGE_ME_production_password
DB_ROOT_PASSWORD=CHANGE_ME_production_root_password
CHAT_DB_DSN=mysql:host=private-db-host;port=3306;dbname=app_production;charset=utf8mb4
CHAT_DB_USER=app_production
CHAT_DB_PASSWORD=CHANGE_ME_production_password
PULSE_RATE_HASH_SECRET=CHANGE_ME_production_secret_at_least_32_chars
CONTACT_EMAIL=admin@example.com
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_PATH=/
