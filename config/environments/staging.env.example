APP_ENV=staging
APP_PORT=8080
SITE_URL=https://staging.example.com
CANONICAL_HOST=staging.example.com
DB_HOST=db
DB_PORT=3306
DB_NAME=app_staging
DB_USER=app_staging
DB_PASSWORD=CHANGE_ME_staging_password
DB_ROOT_PASSWORD=CHANGE_ME_staging_root_password
CHAT_DB_DSN=mysql:host=db;port=3306;dbname=app_staging;charset=utf8mb4
CHAT_DB_USER=app_staging
CHAT_DB_PASSWORD=CHANGE_ME_staging_password
PULSE_RATE_HASH_SECRET=CHANGE_ME_staging_secret_at_least_32_chars
CONTACT_EMAIL=staging@example.com
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_PATH=/
