# Copy to .env and replace every placeholder before starting Compose.
APP_ENV=staging
APP_PORT=8080
SITE_URL=http://localhost:8080
CANONICAL_HOST=localhost

DB_HOST=db
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=CHANGE_ME_app_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password

CHAT_DB_DSN=mysql:host=db;port=3306;dbname=app;charset=utf8mb4
CHAT_DB_USER=app
CHAT_DB_PASSWORD=CHANGE_ME_app_password
PULSE_RATE_HASH_SECRET=CHANGE_ME_generate_at_least_32_random_characters
CONTACT_EMAIL=admin@example.com
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_PATH=/
